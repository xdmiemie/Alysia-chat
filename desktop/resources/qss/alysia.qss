* {
    font-family: "Segoe UI", "Microsoft YaHei UI", sans-serif;
    font-size: 14px;
    color: #eeeaf8;
}

QMainWindow, #customWindowFrame, #windowSurface, #windowBody, #workspaceStack, #chatPage, #trainingPage {
    background: #111225;
}

#titleBar {
    background: #0c0d1c;
    border-bottom: 1px solid #292943;
}

#titleBarMark {
    color: #ff79b8;
    font-size: 18px;
    font-weight: 700;
}

#titleBarTitle {
    color: #dcd8e7;
    font-size: 12px;
    font-weight: 600;
}

#minimizeButton, #maximizeButton, #closeButton {
    background: transparent;
    color: #aaa7b8;
    border: 0;
    border-radius: 7px;
    min-height: 34px;
    padding: 0;
    font-family: "Segoe UI Symbol", "Segoe UI", sans-serif;
    font-size: 16px;
}

#closeButton {
    font-size: 25px;
    font-weight: 500;
    padding-bottom: 3px;
}

#minimizeButton:hover, #maximizeButton:hover {
    background: #292a42;
    color: #ffffff;
}

#closeButton:hover {
    background: #d84f70;
    color: #ffffff;
}

#resizeHandle {
    background: #0c0d1c;
}

#leftNavigation {
    background: #0c0d1c;
    border-right: 1px solid #292943;
}

#brandMark {
    color: #ff80bd;
    font-size: 30px;
    font-weight: 700;
}

#brandName {
    color: #ffffff;
    font-size: 18px;
    font-weight: 700;
}

#brandCaption, #versionLabel, #eyebrow {
    color: #777690;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1px;
}

QPushButton {
    min-height: 38px;
    border: 0;
    border-radius: 10px;
    padding: 0 14px;
}

QPushButton:focus {
    outline: none;
}

#navButton {
    background: transparent;
    color: #a9a5b8;
    font-weight: 600;
    text-align: left;
    min-height: 46px;
}

#navButton:hover {
    background: #191a30;
    color: #ffffff;
}

#navButton:checked {
    background: #29213c;
    color: #ff8ac2;
    border-left: 3px solid #f06fad;
}

#pageTitle {
    color: #ffffff;
    font-size: 25px;
    font-weight: 700;
}

#pageSubtitle, #statusDetail, #cardBody {
    color: #8e8ba1;
}

#localBadge {
    background: #172c29;
    color: #65d5b1;
    border: 1px solid #245047;
    border-radius: 12px;
    padding: 6px 12px;
    font-size: 12px;
}

#messageScroll {
    background: #15162a;
    border: 1px solid #292a45;
    border-radius: 18px;
}

#messageScroll > QWidget > QWidget, #messageCanvas {
    background: #15162a;
}

#messageBubble {
    background: #202039;
    border: 1px solid #31314e;
    border-radius: 16px;
}

#messageBubbleOutgoing {
    background: #4a2949;
    border: 1px solid #6e3b63;
    border-radius: 16px;
}

#bubbleSender {
    color: #f489bc;
    font-size: 12px;
    font-weight: 700;
}

#bubbleText {
    color: #e8e4f0;
    font-size: 14px;
}

#bubbleMeta {
    color: #88859a;
    font-size: 10px;
}

#bubbleAction {
    background: transparent;
    color: #aaa6b8;
    min-height: 24px;
    padding: 0 5px;
    font-size: 11px;
}

#bubbleAction:hover {
    color: #ff8ac2;
}

#voicePlayButton {
    background: #e867a6;
    color: #ffffff;
    border-radius: 18px;
    padding: 0;
    font-size: 15px;
}

#voicePlayButton:disabled {
    background: #3b3b52;
    color: #777489;
}

#voiceWaveform {
    color: #f08aba;
    font-size: 12px;
    letter-spacing: 1px;
}

#voiceWaveform[playing="true"] {
    color: #7ce0c2;
}

#voiceEmotion {
    background: #35243f;
    color: #f3a2c9;
    border-radius: 8px;
    padding: 2px 7px;
    font-size: 10px;
}

#voiceError {
    color: #ff8da5;
    font-size: 11px;
}

#recordingTime {
    color: #ff91bd;
    font-weight: 700;
}

#recordingLevel {
    background: #2b2b43;
    border: 0;
    border-radius: 4px;
    max-height: 8px;
}

#recordingLevel::chunk {
    background: #ef6eaa;
    border-radius: 4px;
}

#voiceProgress::groove:horizontal {
    background: #373750;
    height: 4px;
    border-radius: 2px;
}

#voiceProgress::handle:horizontal {
    background: #f17db5;
    width: 12px;
    margin: -4px 0;
    border-radius: 6px;
}

#conversationBar {
    background: #191a30;
    border: 1px solid #30314d;
    border-radius: 12px;
}

#conversationCombo {
    background: #25263f;
    color: #f1edf8;
    border: 1px solid #454663;
    border-radius: 8px;
    min-height: 34px;
    padding: 0 10px;
}

#compactButton {
    background: #282941;
    color: #d4cfdf;
    border: 1px solid #3b3c58;
    min-height: 34px;
    padding: 0 10px;
}

#compactButton:hover {
    background: #34354f;
}

#composer {
    background: #191a30;
    border: 1px solid #30314d;
    border-radius: 16px;
}

#chatInput {
    background: transparent;
    color: #dad6e5;
    border: 0;
    min-height: 42px;
    padding: 8px;
}

#chatInput:disabled {
    color: #777489;
}

#sendButton, #primaryButton {
    background: #e967a7;
    color: #ffffff;
    font-weight: 700;
}

#sendButton:hover, #primaryButton:hover {
    background: #f27eb7;
}

#sendButton:disabled, #primaryButton:disabled, #secondaryButton:disabled {
    background: #28283c;
    color: #686678;
}

#iconButton {
    background: #25263e;
    color: #aaa7ba;
    min-width: 42px;
    max-width: 42px;
    padding: 0;
}

#iconButton:hover {
    background: #343550;
}

#iconButton[recording="true"] {
    background: #633047;
    border: 1px solid #ef78aa;
}

#characterPanel {
    background: #17182b;
    border-left: 1px solid #292943;
}

#characterAvatar {
    background: #3e2945;
    color: #ffaad1;
    border: 2px solid #76506d;
    border-radius: 44px;
    font-size: 30px;
    font-weight: 700;
}

#characterName {
    color: #ffffff;
    font-size: 21px;
    font-weight: 700;
}

#statusBadge {
    border-radius: 12px;
    padding: 6px 10px;
    font-weight: 600;
}

#statusBadge[tone="idle"] {
    background: #172d2a;
    color: #6ed9b6;
}

#statusBadge[tone="busy"] {
    background: #382d1d;
    color: #f3c36e;
}

#statusBadge[tone="error"] {
    background: #3e202c;
    color: #ff849e;
}

#modelCard, #trainingCard {
    background: #202039;
    border: 1px solid #30314c;
    border-radius: 14px;
}

#cardTitle, #sectionTitle {
    color: #f5f2fb;
    font-weight: 700;
}

#cardHeading {
    color: #ffffff;
    font-size: 17px;
    font-weight: 700;
}

#modelValue {
    color: #aaa7b8;
    font-size: 12px;
}

#errorCard {
    background: #39202c;
    border: 1px solid #7d354c;
    border-radius: 12px;
}

#errorText {
    color: #ffabbc;
}

#secondaryButton {
    background: #282941;
    color: #d4cfdf;
    border: 1px solid #3b3c58;
}

#secondaryButton:hover {
    background: #34354f;
    color: #ffffff;
}

#secondaryButton:pressed {
    background: #454663;
    border-color: #e967a7;
}

#secondaryButton:disabled {
    background: #28283c;
    color: #686678;
    border-color: #333349;
}

#logConsole {
    background: #0c0d1a;
    color: #b9d8cf;
    border: 1px solid #2b2c43;
    border-radius: 12px;
    padding: 12px;
    selection-background-color: #814b72;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 4px 2px;
}

QScrollBar::handle:vertical {
    background: #3b3b55;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QDialog, QTabWidget::pane {
    background: #15162a;
}

#dialogContent, #settingsContent, #settingsPage, #settingsTabs,
#settingsTabs QStackedWidget, #voiceCallContent {
    background: #15162a;
}

#settingsTabs::pane {
    background: #191a30;
    border: 1px solid #30314d;
    border-radius: 10px;
    top: -1px;
}

#settingsPage {
    color: #eeeaf8;
}

#settingsDialog QDialogButtonBox, #settingsDialog QCheckBox {
    background: transparent;
    color: #eeeaf8;
}

#settingsDialog QCheckBox {
    spacing: 9px;
}

#settingsDialog QCheckBox::indicator {
    width: 17px;
    height: 17px;
    background: #24253d;
    border: 1px solid #575873;
    border-radius: 4px;
}

#settingsDialog QCheckBox::indicator:hover {
    border-color: #e96ca9;
}

#settingsDialog QCheckBox::indicator:checked {
    background: #e967a7;
    border-color: #f08abb;
}

#selectionDialog {
    background: #15162a;
}

#dialogTitle {
    color: #ffffff;
    font-size: 20px;
    font-weight: 700;
}

#dialogHint {
    color: #9692a7;
}

#selectionField {
    background: #1d1e35;
    border: 1px solid #30314d;
    border-radius: 12px;
}

#fieldLabel {
    color: #ddd8e7;
    font-weight: 600;
}

#selectionCombo {
    background: #25263f;
    color: #f1edf8;
    border: 1px solid #454663;
    border-radius: 9px;
    padding: 0 38px 0 13px;
    selection-background-color: #70405f;
    selection-color: #ffffff;
}

#selectionCombo:hover, #selectionCombo:focus {
    background: #2b2c47;
    border: 1px solid #e96ca9;
}

#selectionCombo:disabled {
    background: #202136;
    color: #6f6c7e;
    border-color: #303148;
}

#selectionCombo::drop-down {
    background: #31324d;
    border: 0;
    border-left: 1px solid #454663;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    width: 32px;
}

#selectionCombo QAbstractItemView {
    background: #24253d;
    color: #eeeaf8;
    border: 1px solid #4b4c68;
    outline: 0;
    padding: 5px;
    selection-background-color: #70405f;
    selection-color: #ffffff;
}

/* Stage 15 character management: Qt's native editors default to a light
   palette unless every input surface is explicitly themed. */
#characterManagerCombo {
    background: #25263f;
    color: #f1edf8;
    border: 1px solid #454663;
    border-radius: 9px;
    min-height: 38px;
    padding: 0 34px 0 12px;
    selection-background-color: #70405f;
    selection-color: #ffffff;
}

#characterManagerCombo:hover {
    background: #2b2c47;
    border-color: #e96ca9;
}

#characterManagerCombo::drop-down {
    background: #31324d;
    border: 0;
    border-left: 1px solid #454663;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    width: 32px;
}

#characterManagerCombo QAbstractItemView {
    background: #24253d;
    color: #eeeaf8;
    border: 1px solid #4b4c68;
    selection-background-color: #70405f;
    selection-color: #ffffff;
}

#characterManagerDialog, #characterManagerDialog QWidget {
    background: #15162a;
    color: #eeeaf8;
}

#characterManagerDialog QTabWidget::pane {
    background: #191a30;
    border: 1px solid #30314d;
    border-radius: 10px;
    top: -1px;
}

#characterManagerDialog QLineEdit,
#characterManagerDialog QTextEdit,
#characterManagerDialog QSpinBox,
#characterManagerDialog QDoubleSpinBox,
#characterManagerDialog QComboBox,
#characterManagerDialog QListWidget {
    background: #25263f;
    color: #f1edf8;
    border: 1px solid #454663;
    border-radius: 8px;
    padding: 6px 10px;
    selection-background-color: #70405f;
    selection-color: #ffffff;
}

#characterManagerDialog QLineEdit:focus,
#characterManagerDialog QTextEdit:focus,
#characterManagerDialog QSpinBox:focus,
#characterManagerDialog QDoubleSpinBox:focus,
#characterManagerDialog QComboBox:focus,
#characterManagerDialog QListWidget:focus {
    border-color: #e96ca9;
    background: #2b2c47;
}

#characterManagerDialog QLineEdit:read-only {
    background: #202136;
    color: #aaa7b8;
}

#characterManagerDialog QComboBox QAbstractItemView,
#characterManagerDialog QListWidget::item {
    background: #24253d;
    color: #eeeaf8;
    selection-background-color: #70405f;
    selection-color: #ffffff;
}

#characterManagerDialog QListWidget::item {
    padding: 7px;
    border-radius: 5px;
}

#characterManagerDialog QCheckBox {
    background: transparent;
    color: #eeeaf8;
    spacing: 9px;
}

#characterManagerDialog QCheckBox::indicator {
    width: 17px;
    height: 17px;
    background: #24253d;
    border: 1px solid #575873;
    border-radius: 4px;
}

#characterManagerDialog QCheckBox::indicator:checked {
    background: #e967a7;
    border-color: #f08abb;
}

#characterManagerDialog QDialogButtonBox QPushButton {
    background: #e967a7;
    color: #ffffff;
    font-weight: 700;
}

#characterManagerDialog QDialogButtonBox QPushButton:hover {
    background: #f27eb7;
}

#dialogCancelButton, #dialogConfirmButton {
    min-width: 88px;
    min-height: 38px;
}

#dialogCancelButton {
    background: #292a42;
    color: #d1cddd;
    border: 1px solid #42435d;
}

#dialogCancelButton:hover {
    background: #34354f;
    color: #ffffff;
}

#dialogConfirmButton {
    background: #e967a7;
    color: #ffffff;
    font-weight: 700;
}

#dialogConfirmButton:hover {
    background: #f27eb7;
}

QTabBar::tab {
    background: #202039;
    color: #aaa7b8;
    padding: 10px 18px;
}

QTabBar::tab:selected {
    color: #ff8ac2;
    border-bottom: 2px solid #ee6fad;
}

/* Stage 16: tab pages are plain QWidget instances.  They do not inherit a
   stylesheet background from the training shell on every Qt platform, so set
   all four surfaces explicitly instead of allowing the white native fallback. */
#qwen3TrainingTabs, #qwen3TrainingTabs::pane,
#trainingPageScroll, #trainingPageScroll > QWidget > QWidget,
#qwenSourceTabScroll, #qwenSettingsTabScroll, #qwenPreviewTabScroll, #qwenTaskTabScroll,
#qwenSourceTab, #qwenSettingsTab, #qwenPreviewTab, #qwenTaskTab {
    background: #17182d;
    color: #eeeaf8;
}

#trainingPageScroll > QWidget > QWidget,
#qwenSourceTabScroll > QWidget > QWidget,
#qwenSettingsTabScroll > QWidget > QWidget,
#qwenPreviewTabScroll > QWidget > QWidget,
#qwenTaskTabScroll > QWidget > QWidget {
    background: #17182d;
}

#qwen3TrainingTabs::pane {
    border: 1px solid #30314d;
    border-radius: 10px;
    top: -1px;
}

#qwen3TrainingTabs QLineEdit,
#qwen3TrainingTabs QTextEdit,
#qwen3TrainingTabs QSpinBox,
#qwen3TrainingTabs QDoubleSpinBox,
#qwen3TrainingTabs QComboBox {
    background: #25263f;
    color: #f1edf8;
    border: 1px solid #454663;
    border-radius: 8px;
    padding: 6px 10px;
    selection-background-color: #70405f;
    selection-color: #ffffff;
}

#fixedTeacherModel {
    background: #202136;
    color: #c5e6d8;
    border: 1px solid #365b52;
    border-radius: 8px;
    padding: 8px 10px;
    font-weight: 600;
}

#qwen3TrainingTabs QLineEdit:focus,
#qwen3TrainingTabs QTextEdit:focus,
#qwen3TrainingTabs QSpinBox:focus,
#qwen3TrainingTabs QDoubleSpinBox:focus,
#qwen3TrainingTabs QComboBox:focus {
    background: #2b2c47;
    border-color: #e96ca9;
}

#qwen3TrainingTabs QCheckBox {
    background: transparent;
    color: #eeeaf8;
    spacing: 9px;
}

#qwen3TrainingTabs QCheckBox::indicator {
    width: 17px;
    height: 17px;
    background: #24253d;
    border: 1px solid #575873;
    border-radius: 4px;
}

#qwen3TrainingTabs QCheckBox::indicator:checked {
    background: #e967a7;
    border-color: #f08abb;
}

#voiceCallDialog {
    background: #15162a;
}

#voiceCallDialog QSlider::groove:horizontal {
    background: #32334d;
    height: 6px;
    border-radius: 3px;
}

#voiceCallDialog QSlider::sub-page:horizontal {
    background: #e967a7;
    border-radius: 3px;
}

#voiceCallDialog QSlider::handle:horizontal {
    background: #f4a2ca;
    width: 16px;
    margin: -5px 0;
    border-radius: 8px;
}

#callAvatar {
    background: #4a2949;
    color: #ffb4d7;
    border: 3px solid #875573;
    border-radius: 66px;
    font-size: 44px;
    font-weight: 700;
}

#callCharacterName {
    color: #ffffff;
    font-size: 25px;
    font-weight: 700;
}

#callDuration {
    color: #a9a5b8;
    font-size: 18px;
}

#callStatus {
    color: #75dcbc;
    font-size: 15px;
    font-weight: 600;
}

#callLevel {
    background: #292a43;
    border: 0;
    border-radius: 5px;
    max-height: 10px;
}

#callLevel::chunk {
    background: #ed72ad;
    border-radius: 5px;
}

#callTextCard {
    background: #202039;
    border: 1px solid #343451;
    border-radius: 14px;
}

#callTranscript, #callReply {
    color: #e9e5f1;
    padding: 4px 8px;
}

#callReplyToggle {
    background: transparent;
    color: #f18abb;
    text-align: left;
}

#callMuteButton {
    background: #292a43;
    border: 1px solid #41425e;
    border-radius: 29px;
    min-width: 58px;
    max-width: 58px;
    min-height: 58px;
    max-height: 58px;
    padding: 0;
}

#callMuteButton:hover {
    background: #353650;
    border-color: #666784;
}

#callMuteButton:checked {
    background: #4a293d;
    border-color: #db658e;
}

#callEndButton {
    background: #d84f70;
    color: #ffffff;
    border-radius: 31px;
    min-width: 62px;
    max-width: 62px;
    min-height: 62px;
    max-height: 62px;
    padding: 0;
}

#callEndButton:hover {
    background: #e6607f;
}

#callEndButton:pressed {
    background: #bd3e5d;
}
